# Public Supabase connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key used by the Christmas reservation endpoint.
# Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Existing admin access allowlist
ADMIN_EMAIL=donnie@citykid.me

# Christmas reservation email delivery (Resend)
RESEND_API_KEY=
RESERVATION_FROM_EMAIL="Citychurch Christmas <reservations@citykid.me>"
RESERVATION_ADMIN_EMAIL=donnie@citykid.me
NEXT_PUBLIC_SITE_URL=https://www.citykid.me

# Existing Google Sheets backup
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Stripe giving (embedded Checkout on /donate)
# Secret key from https://dashboard.stripe.com/apikeys. Server only.
STRIPE_SECRET_KEY=
# Publishable key from the same page. Safe to expose.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
